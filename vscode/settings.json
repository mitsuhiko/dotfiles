{
  "editor.fontFamily": "MonoLisa",
  "editor.fontLigatures": false,
  "editor.fontSize": 15,
  "editor.fontWeight": "400",
  "extensions.autoUpdate": false,
  "workbench.sideBar.location": "right",
  "vim.gdefault": true,
  "vim.hlsearch": true,
  "cmake.configureOnOpen": false,
  "rust-analyzer.inlayHints.lifetimeElisionHints.useParameterNames": true,
  "editor.parameterHints.enabled": false,
  "editor.bracketPairColorization.enabled": false,
  "workbench.colorCustomizations": {
    "editorBracketHighlight.foreground1": "#ffffff",
    "editorBracketHighlight.foreground2": "#b4dbdc",
    "editorBracketHighlight.foreground3": "#95a1d3",
    "editorBracketHighlight.foreground4": "#7fc6a1",
    "editorBracketHighlight.foreground5": "#cdb480",
    "editorBracketHighlight.foreground6": "#e38d8d",
    "editorInlayHint.background": "#172130",
    "editorInlayHint.foreground": "#a8bad5"
  },
  "[typescript]": {
    "editor.defaultFormatter": "vscode.typescript-language-features",
    "editor.tabSize": 2
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2
  },
  "[rust]": {
    "editor.formatOnSave": true
  },
  "[python]": {
    "editor.formatOnSave": true,
    "editor.formatOnType": true
  },
  "explorer.confirmDelete": false,
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2
  },
  "python.languageServer": "Pylance",
  "python.testing.autoTestDiscoverOnSaveEnabled": false,
  "editor.inlineSuggest.enabled": true,
  "editor.inlayHints.enabled": "offUnlessPressed",
  "github.copilot.enable": {
    "plaintext": false,
    "markdown": false,
    "scminput": false
  },
  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features",
    "editor.tabSize": 2
  },
  "[dart]": {
    "editor.formatOnSave": true,
    "editor.formatOnType": true,
    "editor.rulers": [80],
    "editor.selectionHighlight": false,
    "editor.suggest.snippetsPreventQuickSuggestions": false,
    "editor.suggestSelection": "first",
    "editor.tabCompletion": "onlySnippets",
    "editor.wordBasedSuggestions": "off"
  },
  "dart.flutterSdkPath": "/Users/mitsuhiko/Development/flutter",
  "[javascriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2
  },
  "rust-analyzer.imports.granularity.group": "module",
  "rust-analyzer.imports.prefix": "crate",
  "rust-analyzer.inlayHints.chainingHints.enable": true,
  "rust-analyzer.inlayHints.closureReturnTypeHints.enable": "always",
  "rust-analyzer.inlayHints.reborrowHints.enable": "always",
  "rust-analyzer.inlayHints.typeHints.enable": true,
  "editor.minimap.enabled": false,
  "rust-analyzer.completion.snippets.custom": {
    "IfLetSome": {
      "description": "Postfix snippet to generate a If let Some(?)",
      "postfix": "ifsome",
      "scope": "expr",
      "body": ["if let Some(val) = ${receiver} {", "\t${0}", "}"]
    },
    "IfLetOk": {
      "description": "Postfix snippet to generate a If let Ok(?)",
      "postfix": "ifok",
      "scope": "expr",
      "body": ["if let Ok(val) = ${receiver} {", "\t${0}", "}"]
    }
  },
  "git.autofetch": true,
  "editor.codeActionsOnSave": {},
  "workbench.colorTheme": "Night Owl (No Italics)",
  "githubPullRequests.pullBranch": "never",
  "[html]": {
    "editor.defaultFormatter": "vscode.html-language-features"
  },
  "[c]": {
    "editor.defaultFormatter": "ms-vscode.cpptools"
  },
  "makefile.configureOnOpen": false,
  "amp.url": "https://ampcode.com/",
  "typescript.updateImportsOnFileMove.enabled": "always",
  "github.copilot.selectedCompletionModel": "",
  "[css]": {
    "editor.defaultFormatter": "vscode.css-language-features"
  },
  "github.copilot.nextEditSuggestions.enabled": true,
  "go.toolsManagement.autoUpdate": true,
  "javascript.updateImportsOnFileMove.enabled": "always",
  "amp.tab.enabled": true,
  "editor.unicodeHighlight.ambiguousCharacters": false,
  "python.defaultInterpreterPath": "/opt/homebrew/bin/python3",
  "biome.suggestInstallingGlobally": false,
  "zig.zls.enabled": "on",
  "chat.viewSessions.orientation": "stacked"
}
